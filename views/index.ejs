<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header>
    <p>Quick<span>Weather</span><i class="fa-solid fa-cloud"></i></p>
    <i class="fa-solid fa-sun" style="color: white; cursor: pointer;"></i>
   </header>

   <main>
    <h1 class="intro">Quick <br> Weather</h1>
    <p class="service">Real time weather forecast.</p>

    <form action="/submit" method="post">
  <input type="text" name="location" id="" class="location" placeholder="type in your location" required>
  <button type="submit" class="submit">Search</button>
    </form>
     <% if(locals.content){ %>
    <div class="output">
        <div class="first">
          <span class="doer">
            <p class="param">Location</p>
            <p class="answer"><%= content.location %></p>
          </span>

           <span class="doer">
           <p class="param">Temperature</p>
            <p class="answer"><%= content.temperature%>˚C</p>
          </span>

          
        <span class="doer">
            <p class="param">Description</p>
            <p class="answer"><%= content.description %></p>
          </span>
        


        </div>

        <div class="second">
          
          
          <span class="doer">
            <p class="param">Weather Icon</p>
            <p class="answer"><%- content.icon %></p>
          </span>

             <span class="doer">
             <p class="param">Sunrise</p>
            <p class="answer"><%= content.sunrise %></p>
          </span>

            <span class="doer">
           <p class="param">Sunset</p>
            <p class="answer"><%= content.sunset %></p>
          </span>

          
        </div>
          <% } %>

        <% if(!locals.content){ %>
          <h3 class="data"><%= starter %></h3>
        <% } %>
        </div>
   </main>
</body>
</html>